# Copy to .env.local to override locally. All values are public (shipped to the browser).

# Absolute origin of the live site, no trailing slash. Drives canonical URLs, Open Graph,
# the sitemap, robots.txt, structured data and the résumé/portfolio links.
VITE_SITE_URL=https://thedeepanshu.vercel.app

# Search engine ownership verification (optional; the meta tag is only added when set).
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
